{
  "version": 1,
  "id": "rubella_crs",
  "category": "Respiratory",
  "name": "Rubella with two age groups, routine infant vaccination, and congenital rubella syndrome (CRS) as an output",
  "description": "Rubella / CRS.\nParameter values: 0 of 9 checked against the source; the rest are recalled or illustrative.",
  "reference": "Anderson RM, May RM. \"Vaccination against rubella and measles: quantitative investigations of different policies.\" J Hyg (Lond) 1983;90:259–325",
  "referenceUrl": "https://doi.org/10.1017/S002217240002893X",
  "time": {
    "start": "0",
    "stop": "80",
    "step": "0.1",
    "unit": "years"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "Sch",
      "description": "susceptible child, 0–14 y",
      "init": "0.1*N0",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 220
    },
    {
      "id": "c2",
      "name": "Ich",
      "description": "infectious child",
      "init": "50",
      "inN": true,
      "color": "#B71C1C",
      "x": 320,
      "y": 140
    },
    {
      "id": "c3",
      "name": "Rch",
      "description": "immune child",
      "init": "0.1*N0",
      "inN": true,
      "color": "#4E8A3E",
      "x": 520,
      "y": 140
    },
    {
      "id": "c4",
      "name": "Sad",
      "description": "susceptible adult, 15+ y",
      "init": "0.05*N0",
      "inN": true,
      "color": "#FFFFFF",
      "x": 320,
      "y": 300
    },
    {
      "id": "c5",
      "name": "Iad",
      "description": "infectious adult",
      "init": "50",
      "inN": true,
      "color": "#B71C1C",
      "x": 520,
      "y": 300
    },
    {
      "id": "c6",
      "name": "Rad",
      "description": "immune adult",
      "init": "0.6*N0",
      "inN": true,
      "color": "#4E8A3E",
      "x": 720,
      "y": 220
    },
    {
      "id": "c7",
      "name": "V",
      "description": "vaccinated, all ages",
      "init": "0.15*N0",
      "inN": true,
      "color": "#2457C5",
      "x": 120,
      "y": 516
    },
    {
      "id": "c8",
      "name": "CRS",
      "description": "cumulative CRS births",
      "init": "0",
      "inN": false,
      "color": "#8E0E0E",
      "x": 120,
      "y": 732
    }
  ],
  "parameters": [
    {
      "name": "R0_r",
      "symbol": "",
      "value": "7",
      "description": "illustrative; commonly cited range about 6–7"
    },
    {
      "name": "g_rec",
      "symbol": "",
      "value": "365/11",
      "description": "11-day infectious period (1/year) [illustrative]"
    },
    {
      "name": "age_out",
      "symbol": "",
      "value": "1/15",
      "description": "ageing from child to adult (1/year)"
    },
    {
      "name": "mu_ad",
      "symbol": "",
      "value": "1/55",
      "description": "adult death rate, so life expectancy is 70 (1/year) [illustrative]"
    },
    {
      "name": "p_vac",
      "symbol": "",
      "value": "0.8",
      "description": "fraction of births vaccinated [illustrative]"
    },
    {
      "name": "preg_frac",
      "symbol": "",
      "value": "0.015",
      "description": "fraction of adults who are women in the first 16 weeks of pregnancy at any time [illustrative]"
    },
    {
      "name": "q_crs",
      "symbol": "",
      "value": "0.6",
      "description": "probability of CRS given infection in that window, averaged over weeks 0–16 [illustrative]"
    },
    {
      "name": "births",
      "symbol": "",
      "value": "1e6/70",
      "description": "constant births, roughly balancing deaths (persons/year) [illustrative]"
    },
    {
      "name": "N0",
      "symbol": "",
      "value": "1e6",
      "description": "value taken from the notes text [recalled]"
    }
  ],
  "variables": [
    {
      "name": "foi",
      "symbol": "",
      "expr": "R0_r*g_rec*(Ich + Iad)/N",
      "description": "",
      "output": false
    },
    {
      "name": "crs_rate",
      "symbol": "",
      "expr": "q_crs*preg_frac*foi*Sad",
      "description": "",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": null,
      "to": "c1",
      "kind": "absolute",
      "rate": "(1-p_vac)*births",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 90
    },
    {
      "id": "f2",
      "from": null,
      "to": "c7",
      "kind": "absolute",
      "rate": "p_vac*births",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 386
    },
    {
      "id": "f3",
      "from": "c1",
      "to": "c2",
      "kind": "per_capita",
      "rate": "foi",
      "output": "",
      "curve": 0
    },
    {
      "id": "f4",
      "from": "c2",
      "to": "c3",
      "kind": "per_capita",
      "rate": "g_rec",
      "output": "",
      "curve": 0
    },
    {
