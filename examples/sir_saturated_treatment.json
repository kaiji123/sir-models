      "from": "c2",
      "to": "c3",
      "kind": "per_capita",
      "rate": "treat_pc",
      "output": "",
      "curve": 0
    },
    {
      "id": "f5",
      "from": "c1",
      "to": null,
      "kind": "per_capita",
      "rate": "mu",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 270
    },
    {
      "id": "f6",
      "from": "c2",
      "to": null,
