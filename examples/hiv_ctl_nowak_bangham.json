      "x": 120,
      "y": 572
    }
  ],
  "parameters": [
    {
      "name": "lam",
      "symbol": "",
      "value": "10",
      "description": "target-cell production [illustrative] (cells day⁻¹)"
    },
    {
      "name": "dT",
      "symbol": "",
      "value": "0.1",
      "description": "target-cell death rate [illustrative] (per day)"
    },
    {
      "name": "beta",
      "symbol": "",
      "value": "0.002",
      "description": "infection rate constant [illustrative] (per virus per day)"
    },
    {
      "name": "aI",
      "symbol": "",
      "value": "0.5",
      "description": "infected-cell death rate in the absence of CTL [illustrative] (per day)"
    },
    {
      "name": "pz",
      "symbol": "",
      "value": "1.0",
      "description": "rate of CTL-mediated killing of infected cells (pz because p is used for production and c is reserved) [illustrative] (per CTL per day)"
    },
    {
      "name": "kv",
      "symbol": "",
      "value": "50",
      "description": "virus production per infected cell [illustrative] (virions cell⁻¹ day⁻¹)"
    },
    {
      "name": "uV",
      "symbol": "",
      "value": "5",
      "description": "virus clearance rate [illustrative] (per day)"
    },
    {
      "name": "cz",
      "symbol": "",
      "value": "0.1",
      "description": "rate of CTL proliferation driven by antigen [illustrative] (per infected cell per day)"
    },
    {
      "name": "bz",
      "symbol": "",
      "value": "0.05",
      "description": "CTL death rate [illustrative] (per day)"
    }
  ],
  "variables": [
    {
      "name": "R0v",
      "symbol": "",
      "expr": "beta * kv * (lam / dT) / (uV * aI)",
      "description": "reproductive ratio without immune control",
      "output": false
    },
    {
      "name": "Istar_imm",
      "symbol": "",
      "expr": "bz / cz",
      "description": "infected-cell abundance at the immune-controlled equilibrium: a key published insight is that this level is set entirely by CTL parameters, ",
      "output": false
    },
    {
      "name": "Zstar",
      "symbol": "",
      "expr": "(beta * Tc * V / Ii - aI) / pz",
      "description": "equilibrium CTL level (evaluate symbolically, not in the ODE)",
      "output": false
    }
  ],
