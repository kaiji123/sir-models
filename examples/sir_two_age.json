      "color": "#B71C1C",
      "x": 320,
      "y": 332
    },
    {
      "id": "c6",
      "name": "Ra",
      "description": "Recovered adults",
      "init": "79000",
      "inN": true,
      "color": "#4E8A3E",
      "x": 520,
      "y": 332
    }
  ],
  "parameters": [
    {
      "name": "b_cc",
      "symbol": "β_cc",
      "value": "1000",
      "description": "transmission child -> child per year"
    },
    {
      "name": "b_ca",
      "symbol": "β_ca",
      "value": "300",
      "description": "transmission adult -> child per year"
    },
    {
      "name": "b_ac",
      "symbol": "β_ac",
      "value": "300",
      "description": "transmission child -> adult per year"
    },
    {
      "name": "b_aa",
      "symbol": "β_aa",
      "value": "400",
      "description": "transmission adult -> adult per year"
    },
    {
      "name": "gamma",
      "symbol": "",
      "value": "365 / 7",
      "description": "recovery rate per year"
    },
    {
      "name": "ageing",
      "symbol": "",
      "value": "1 / 15",
      "description": "rate of moving from child to adult per year"
    },
    {
      "name": "mu",
      "symbol": "",
      "value": "1 / 70",
      "description": "birth rate per year (deaths in adults keep N constant)"
    }
  ],
  "variables": [
    {
      "name": "lam_c",
      "symbol": "λ_c",
      "expr": "(b_cc * Ic + b_ca * Ia) / N",
      "description": "force of infection on children",
      "output": false
    },
    {
      "name": "lam_a",
      "symbol": "λ_a",
      "expr": "(b_ac * Ic + b_aa * Ia) / N",
      "description": "force of infection on adults",
      "output": false
    },
    {
      "name": "mu_a",
      "symbol": "",
      "expr": "mu * N / (Sa + Ia + Ra)",
      "description": "adult death rate balancing births",
      "output": false
    }
  ],
  "flows": [
