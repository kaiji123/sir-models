{
  "version": 1,
  "id": "sir_two_age",
  "category": "Transmission routes",
  "name": "SIR with two age groups",
  "description": "Children and adults with a who-acquires-infection-from-whom (WAIFW) matrix and ageing.",
  "reference": "Anderson & May (1991), Infectious Diseases of Humans, ch. 9; Keeling & Rohani (2008), Modeling Infectious Diseases in Humans and Animals, §3.1",
  "referenceUrl": "",
  "time": {
