{
  "version": 1,
  "id": "typhoid_pitzer2014",
  "category": "Water, enteric & NTDs",
  "name": "Typhoid with chronic carriers, short- and long-cycle (water) transmission",
  "description": "Typhoid fever (S. Typhi), South Asia (Kolkata, Delhi, Vellore).\nParameter values: 3 of 11 checked against the source; the rest are recalled or illustrative.",
  "reference": "Pitzer VE, Bowles CC, Baker S, Kang G, Balaji V, Farrar JJ, Grenfell BT. Predicting the impact of vaccination on the transmission dynamics of typhoid in South Asia: a mathematical modeling study. PLoS Negl Trop Dis 2014;8(1):e2642",
  "referenceUrl": "https://doi.org/10.1371/journal.pntd.0002642",
  "time": {
    "start": "0",
    "stop": "50",
    "step": "0.05",
    "unit": "weeks"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "S1",
      "description": "fully susceptible",
      "init": "0.3",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 220
    },
    {
      "id": "c2",
      "name": "I1",
      "description": "primary (clinical-capable) infection",
      "init": "100",
      "inN": true,
      "color": "#B71C1C",
      "x": 320,
      "y": 220
    },
    {
      "id": "c3",
      "name": "Car",
      "description": "chronic carrier. C is avoided because it is an R function",
      "init": "0.005",
      "inN": true,
      "color": "#8E0E0E",
      "x": 520,
      "y": 140
    },
    {
      "id": "c4",
      "name": "R",
      "description": "immune",
      "init": "0.4",
      "inN": true,
      "color": "#4E8A3E",
      "x": 520,
      "y": 300
    },
    {
      "id": "c5",
      "name": "S2",
      "description": "partially susceptible after waning",
      "init": "0.3",
      "inN": true,
      "color": "#FFFFFF",
      "x": 720,
      "y": 220
    },
    {
      "id": "c6",
      "name": "I2",
      "description": "subclinical reinfection",
      "init": "0",
      "inN": true,
      "color": "#B71C1C",
      "x": 920,
      "y": 220
    },
    {
      "id": "c7",
      "name": "W",
      "description": "water-supply contamination, scaled to prevalence units",
      "init": "0",
      "inN": false,
      "color": "#A5D6A7",
      "x": 120,
      "y": 516
    }
  ],
  "parameters": [
    {
      "name": "R0_ty",
      "symbol": "",
      "value": "2.8",
      "description": "basic reproduction number, Kolkata fit [verified]"
    },
    {
      "name": "frac_short",
      "symbol": "",
      "value": "0.9",
      "description": "share of R0 from short-cycle transmission [verified]"
    },
    {
      "name": "r_car",
      "symbol": "",
      "value": "0.01",
      "description": "relative infectiousness of carriers (best fit). The model also applies it to I2 [V for carriers; M/I for applying it to I2]."
    },
    {
      "name": "theta_c",
      "symbol": "",
      "value": "0.03",
      "description": "probability that a primary infection becomes a lifelong carrier. The paper uses age-specific values of 0.3–10.1%, so 0.03 is an [I] average [V range]."
    },
    {
      "name": "p_clin",
      "symbol": "",
      "value": "0.1",
      "description": "fraction of primary infections that are clinical typhoid. Used only for reporting [V]."
    },
    {
      "name": "rep_f",
      "symbol": "",
      "value": "0.0052",
      "description": "reporting fraction [verified]"
    },
    {
      "name": "delta_i",
      "symbol": "",
      "value": "0.25",
      "description": "recovery rate (4-week infectiousness) [M] (week^-1)"
    },
    {
      "name": "omega_r",
      "symbol": "",
      "value": "0.0096",
      "description": "waning R → S2 (about 104 weeks) [M] (week^-1)"
    },
    {
      "name": "xi_w",
      "symbol": "",
      "value": "0.333",
      "description": "decay of water contamination (about 3 weeks) [M] (week^-1)"
    },
    {
      "name": "mu_h",
      "symbol": "",
      "value": "0.000385",
      "description": "birth = death rate (50-year life) [I]. The paper used observed demography. (week^-1)"
    },
    {
      "name": "amp_w",
      "symbol": "",
      "value": "0.3",
      "description": "seasonal amplitude of long-cycle transmission [I]. The paper fitted seasonality."
    }
  ],
  "variables": [
    {
      "name": "D_eff",
      "symbol": "",
      "expr": "1/(delta_i + mu_h) + theta_c*delta_i/(delta_i + mu_h)*r_car/mu_h",
      "description": "effective infectious duration per primary case (about 4.78 weeks)",
      "output": false
    },
    {
      "name": "beta_s",
      "symbol": "",
      "expr": "frac_short*R0_ty/D_eff",
      "description": "short-cycle rate (week^-1)",
      "output": false
    },
    {
      "name": "beta_l",
      "symbol": "",
      "expr": "(1 - frac_short)*R0_ty/D_eff",
      "description": "long-cycle rate. W is scaled so that its equilibrium equals the weighted prevalence.",
      "output": false
    },
    {
      "name": "prev_w",
      "symbol": "",
      "expr": "(I1 + r_car*Car + r_car*I2)/N",
      "description": "",
      "output": false
    },
    {
      "name": "lam",
      "symbol": "",
      "expr": "beta_s*prev_w + beta_l*(1 + amp_w*cos(6.2831853*t/52))*W",
      "description": "",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": null,
      "to": "c1",
      "kind": "absolute",
      "rate": "mu_h*N",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 90
    },
    {
      "id": "f2",
      "from": "c1",
      "to": "c2",
      "kind": "per_capita",
      "rate": "lam",
      "output": "",
      "curve": 0
    },
    {
      "id": "f3",
      "from": "c2",
      "to": "c3",
      "kind": "per_capita",
      "rate": "theta_c*delta_i",
      "output": "",
      "curve": 0
    },
    {
      "id": "f4",
      "from": "c2",
      "to": "c4",
      "kind": "per_capita",
      "rate": "(1 - theta_c)*delta_i",
      "output": "",
      "curve": 0
    },
    {
      "id": "f5",
      "from": "c4",
      "to": "c5",
      "kind": "per_capita",
      "rate": "omega_r",
      "output": "",
      "curve": 0
    },
    {
      "id": "f6",
      "from": "c5",
      "to": "c6",
      "kind": "per_capita",
      "rate": "lam",
      "output": "",
      "curve": 0
    },
    {
      "id": "f7",
      "from": "c6",
      "to": "c4",
      "kind": "per_capita",
      "rate": "delta_i",
      "output": "",
      "curve": 60
    },
    {
      "id": "f8",
      "from": "c1",
      "to": null,
      "kind": "per_capita",
      "rate": "mu_h",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 350
    },
    {
      "id": "f9",
      "from": "c2",
      "to": null,
      "kind": "per_capita",
      "rate": "mu_h",
      "output": "",
      "curve": 0,
      "ox": 320,
      "oy": 350
    },
    {
      "id": "f10",
      "from": "c3",
      "to": null,
      "kind": "per_capita",
      "rate": "mu_h",
      "output": "",
      "curve": 0,
      "ox": 520,
      "oy": 270
    },
    {
      "id": "f11",
      "from": "c4",
      "to": null,
      "kind": "per_capita",
      "rate": "mu_h",
      "output": "",
      "curve": 0,
      "ox": 520,
      "oy": 430
    },
    {
      "id": "f12",
      "from": "c5",
      "to": null,
      "kind": "per_capita",
      "rate": "mu_h",
      "output": "",
      "curve": 0,
      "ox": 720,
      "oy": 350
    },
    {
      "id": "f13",
      "from": "c6",
      "to": null,
      "kind": "per_capita",
      "rate": "mu_h",
      "output": "",
      "curve": 0,
      "ox": 920,
      "oy": 350
    },
    {
      "id": "f14",
      "from": null,
      "to": "c7",
      "kind": "absolute",
      "rate": "xi_w*prev_w",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 386
    },
    {
      "id": "f15",
      "from": "c7",
      "to": null,
      "kind": "per_capita",
      "rate": "xi_w",
      "output": "",
