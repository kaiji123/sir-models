      "x": 720,
      "y": 300
    },
    {
      "id": "c10",
      "name": "Fail1",
      "description": "failed treatment, high risk",
      "init": "5",
      "inN": true,
      "color": "#5D4037",
      "x": 920,
      "y": 300
    }
  ],
  "parameters": [
    {
      "name": "pi_inf",
      "symbol": "",
      "value": "0.2",
      "description": "infection rate coefficient (/yr) [illustrative]"
    },
    {
      "name": "Pi_h",
      "symbol": "",
      "value": "3.6",
      "description": "relative risk for high-risk PWID [verified]"
    },
    {
      "name": "kappa",
      "symbol": "",
      "value": "12/14",
      "description": "high to low risk (duration 14 months) (/yr) [verified]"
    },
    {
      "name": "f_high",
      "symbol": "",
      "value": "0.33",
      "description": "fraction of new injectors entering high risk [illustrative]"
    },
    {
      "name": "delta_c",
      "symbol": "",
      "value": "0.26",
      "description": "proportion of acute infections clearing spontaneously [verified]"
    },
    {
      "name": "psi_a",
      "symbol": "",
      "value": "2",
      "description": "exit from acute (6 months) (/yr) [verified]"
    },
    {
      "name": "mu1",
      "symbol": "",
      "value": "1/11",
      "description": "permanent cessation of injecting (11 yr career) (/yr) [verified]"
    },
    {
      "name": "mu2",
      "symbol": "",
      "value": "0.01",
      "description": "death rate (/yr) [verified]"
    },
    {
      "name": "phi_tx",
      "symbol": "",
      "value": "8",
      "description": "treatments started per year (per 1000 PWID per yr) [verified]"
    },
    {
      "name": "omega",
      "symbol": "",
      "value": "52/12",
      "description": "1/treatment duration (12 weeks for IFN-free DAA) (/yr) [verified]"
    },
    {
      "name": "alpha_svr",
      "symbol": "",
      "value": "0.9",
      "description": "SVR with IFN-free DAAs [verified]"
    }
  ],
  "variables": [
    {
      "name": "Ntot",
      "symbol": "",
      "expr": "X0+A0+Ch0+Tx0+Fail0+X1+A1+Ch1+Tx1+Fail1",
      "description": "total PWID",
      "output": false
    },
    {
      "name": "Chtot",
      "symbol": "",
      "expr": "Ch0+Ch1",
      "description": "total chronic infections",
      "output": false
    },
    {
      "name": "Infectious",
      "symbol": "",
      "expr": "A0+A1+Ch0+Ch1+Fail0+Fail1+(1-alpha_svr)*(Tx0+Tx1)",
      "description": "those on treatment who will achieve SVR are non-infectious [verified assumption]",
      "output": false
    },
    {
      "name": "foi0",
      "symbol": "",
      "expr": "pi_inf*Infectious/Ntot",
      "description": "force of infection, low risk",
      "output": false
    },
    {
      "name": "foi1",
      "symbol": "",
      "expr": "Pi_h*pi_inf*Infectious/Ntot",
      "description": "force of infection, high risk",
      "output": false
    },
    {
      "name": "tx_pc",
      "symbol": "",
      "expr": "pmin(phi_tx/1000*Ntot/max(Chtot, 1e-6), 52)",
      "description": "per-capita treatment rate implementing a fixed number treated per year; capped",
      "output": false
    },
    {
      "name": "exit_r",
      "symbol": "",
      "expr": "mu1 + mu2",
      "description": "total exit rate (cessation plus death)",
      "output": false
    }
  ],
  "flows": [
