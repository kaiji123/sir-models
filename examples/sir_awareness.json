{
  "version": 1,
  "id": "sir_awareness",
  "category": "Classic extensions",
  "name": "SIR with aware (behaviour-changing) susceptibles",
  "description": "generic emerging infection; awareness/behaviour.\nAwareness is triggered only by prevalence, so the disease-free state has Sa = 0 and the epidemic threshold R0 = beta/gamma is unchanged.\nParameter values: 0 of 5 checked against the source; the rest are recalled or illustrative.",
  "reference": "The concept and qualitative result come from Funk S., Gilad E., Watkins C., Jansen V.A.A. (2009) \"The spread of awareness and its impact on epidemic outbreaks\", PNAS 106(16):6872–6877",
  "referenceUrl": "https://doi.org/10.1073/pnas.0810762106",
  "time": {
    "start": "0",
    "stop": "200",
    "step": "0.2",
    "unit": "days"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "S",
      "description": "unaware susceptible",
      "init": "9990",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 140
    },
    {
      "id": "c2",
      "name": "Sa",
      "description": "aware susceptible (reduced contacts)",
      "init": "0",
      "inN": true,
      "color": "#FFFFFF",
      "x": 320,
      "y": 140
    },
    {
      "id": "c3",
      "name": "I",
      "description": "infectious",
      "init": "10",
      "inN": true,
      "color": "#B71C1C",
      "x": 520,
      "y": 140
    },
    {
      "id": "c4",
      "name": "R",
      "description": "recovered",
      "init": "0",
      "inN": true,
      "color": "#4E8A3E",
      "x": 720,
      "y": 140
    }
  ],
  "parameters": [
    {
      "name": "beta",
      "symbol": "",
      "value": "0.4",
      "description": "transmission rate (1/day) [illustrative]"
    },
    {
      "name": "gamma",
      "symbol": "",
      "value": "0.2",
      "description": "recovery (1/day) [illustrative]"
    },
    {
      "name": "phi_a",
      "symbol": "",
      "value": "2.0",
      "description": "awareness generation from contact with or news of cases (1/day) [illustrative]"
    },
    {
      "name": "omega_f",
      "symbol": "",
      "value": "0.05",
      "description": "awareness fading (1/day) [illustrative]"
    },
    {
      "name": "sigma_a",
      "symbol": "",
      "value": "0.3",
      "description": "relative susceptibility of aware susceptibles [illustrative]"
    }
  ],
  "variables": [
    {
      "name": "lambda",
      "symbol": "",
      "expr": "beta*I/N",
      "description": "force of infection",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "c1",
      "to": "c2",
      "kind": "per_capita",
      "rate": "phi_a*I/N",
      "output": "",
      "curve": 0
    },
    {
      "id": "f2",
      "from": "c2",
      "to": "c1",
      "kind": "per_capita",
      "rate": "omega_f",
      "output": "",
      "curve": 60
    },
    {
      "id": "f3",
      "from": "c1",
      "to": "c3",
      "kind": "per_capita",
      "rate": "lambda",
      "output": "",
      "curve": 50
    },
    {
      "id": "f4",
      "from": "c2",
      "to": "c3",
      "kind": "per_capita",
      "rate": "sigma_a*lambda",
      "output": "",
      "curve": 0
    },
    {
      "id": "f5",
      "from": "c3",
      "to": "c4",
      "kind": "per_capita",
      "rate": "gamma",
      "output": "",
      "curve": 0
    }
  ]
}
