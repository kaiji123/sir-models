  "parameters": [
    {
      "name": "beta_s",
      "symbol": "",
      "value": "10",
      "description": "effective contacts per infectious case per year (1/year) [illustrative]"
    },
    {
      "name": "fit_r",
      "symbol": "",
      "value": "0.8",
