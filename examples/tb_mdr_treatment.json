      "description": "reactivation from latency (1/year) [illustrative]"
    },
    {
      "name": "x_prot",
      "symbol": "",
      "value": "0.65",
      "description": "protection of latent and recovered people against reinfection-driven fast progression [illustrative]"
    },
    {
      "name": "cure_nat",
      "symbol": "",
      "value": "0.2",
      "description": "self-cure (1/year) [illustrative]"
    },
    {
      "name": "mu_tb",
      "symbol": "",
      "value": "0.2",
      "description": "TB death, untreated (1/year) [illustrative]"
    },
    {
      "name": "det",
      "symbol": "",
      "value": "0.7",
      "description": "detection and treatment rate (1/year) [illustrative]"
    },
    {
      "name": "succ_s",
      "symbol": "",
      "value": "0.85",
      "description": "treatment success for DS-TB [illustrative]"
    },
    {
      "name": "a_res",
      "symbol": "",
      "value": "0.03",
      "description": "fraction of DS treatments that produce MDR [illustrative]"
    },
    {
      "name": "succ_r",
      "symbol": "",
      "value": "0.5",
      "description": "first-line treatment success for MDR [illustrative]"
    },
    {
      "name": "relapse",
      "symbol": "",
      "value": "0.002",
      "description": "relapse from Rt to DS active disease (1/year) [illustrative]"
    },
    {
      "name": "mu",
      "symbol": "",
      "value": "0.02",
      "description": "birth = non-TB death rate (1/year)"
    },
    {
      "name": "N0",
      "symbol": "",
      "value": "1e6",
      "description": "value taken from the notes text [recalled]"
    }
  ],
  "variables": [
