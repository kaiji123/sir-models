      "description": "transmission rate (/yr) [verified]"
    },
    {
      "name": "psi",
      "symbol": "",
      "value": "0.63",
      "description": "proportion of infections becoming symptomatic [verified]"
    },
    {
      "name": "sig_inc",
      "symbol": "",
      "value": "77",
      "description": "rate of leaving incubation (about 4.7 days) (/yr) [verified]"
    },
    {
      "name": "nu",
      "symbol": "",
      "value": "1.8",
      "description": "natural recovery from asymptomatic infection, sensitive strain (/yr) [verified]"
    },
    {
      "name": "alpha_r",
      "symbol": "",
      "value": "1.8",
      "description": "relative natural recovery rate of the resistant strain (fitness cost) [verified]"
    },
    {
      "name": "mu_t",
      "symbol": "",
      "value": "136",
      "description": "treatment-seeking rate when symptomatic (/yr) [verified]"
    },
    {
      "name": "rho",
      "symbol": "",
      "value": "53",
      "description": "recovery rate after treatment (/yr) [verified]"
    },
    {
      "name": "phi_f",
      "symbol": "",
      "value": "0.83",
      "description": "cefixime treatment failure for resistant infection [verified]"
    },
    {
      "name": "pi_cef",
      "symbol": "",
      "value": "0.3",
      "description": "proportion treated with cefixime [illustrative]"
