      "color": "#B71C1C",
      "x": 520,
      "y": 516
    }
  ],
  "parameters": [
    {
      "name": "a_bite",
      "symbol": "",
      "value": "0.5",
      "description": ""
    },
    {
      "name": "b_vh",
      "symbol": "",
      "value": "0.4",
      "description": "P(mosquito → human) per bite"
    },
    {
      "name": "p_hv",
      "symbol": "",
      "value": "0.5",
      "description": "P(symptomatic human → mosquito) per bite"
    },
    {
      "name": "eta",
      "symbol": "",
      "value": "0.1",
      "description": "relative human → mosquito infectivity of Eh"
    },
    {
      "name": "bet_sex",
      "symbol": "",
      "value": "0.05",
      "description": "sexual transmission rate from symptomatic humans"
    },
    {
      "name": "kappa",
      "symbol": "",
      "value": "0.6",
      "description": "relative sexual infectivity of Eh"
    },
    {
      "name": "tau_c",
      "symbol": "",
      "value": "0.3",
      "description": "relative sexual infectivity of convalescent I2"
    },
    {
      "name": "theta",
      "symbol": "",
      "value": "0.18",
      "description": "proportion symptomatic"
    },
    {
      "name": "m_ratio",
      "symbol": "",
      "value": "5",
      "description": ""
    },
    {
      "name": "nu_h",
      "symbol": "",
      "value": "0.2",
      "description": "1/(5 d) intrinsic incubation [2–7 d] (1/day)"
    },
    {
      "name": "nu_v",
      "symbol": "",
      "value": "0.1",
      "description": "1/(10 d) extrinsic incubation [8–12 d] (1/day)"
    },
    {
      "name": "gam_h1",
      "symbol": "",
      "value": "0.2",
      "description": "1/(5 d) acute phase [3–7 d] (1/day)"
    },
    {
      "name": "gam_h2",
      "symbol": "",
      "value": "0.05",
      "description": "1/(20 d) convalescent phase [14–30 d] (1/day)"
    },
    {
      "name": "gam_ha",
      "symbol": "",
      "value": "0.1429",
      "description": "1/(7 d) asymptomatic infection [5–10 d] (1/day)"
    },
    {
      "name": "mu_v",
      "symbol": "",
      "value": "0.0714",
      "description": "1/(14 d) mosquito life [4–35 d] (1/day)"
    }
  ],
  "variables": [
    {
      "name": "Nh",
      "symbol": "",
      "expr": "Sh + Eh + I1 + I2 + Ah + Rh",
      "description": "",
      "output": false
    },
    {
      "name": "Nv",
      "symbol": "",
      "expr": "Sv + Ev + Iv",
      "description": "",
      "output": false
    },
    {
      "name": "lambda_h",
      "symbol": "",
      "expr": "a_bite*b_vh*Iv/Nh + bet_sex*(kappa*Eh + I1 + tau_c*I2)/Nh",
      "description": "vector-borne plus sexual force of infection",
      "output": false
    },
    {
      "name": "lambda_v",
      "symbol": "",
      "expr": "a_bite*p_hv*(eta*Eh + I1)/Nh",
      "description": "mosquito force of infection",
      "output": false
    }
  ],
  "flows": [
