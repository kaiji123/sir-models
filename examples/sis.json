{
  "version": 1,
  "id": "sis",
  "category": "Basic",
  "name": "SIS",
  "description": "Infection without lasting immunity (e.g. many bacterial STIs): recovered people become susceptible again.",
  "reference": "Keeling & Rohani (2008), Modeling Infectious Diseases in Humans and Animals, §2.4",
  "referenceUrl": "",
  "time": {
    "start": "0",
    "stop": "200",
    "step": "1",
    "unit": "days"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "S",
      "description": "Susceptible",
      "init": "999",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 140
    },
    {
      "id": "c2",
      "name": "I",
      "description": "Infectious",
      "init": "1",
      "inN": true,
      "color": "#B71C1C",
      "x": 320,
      "y": 140
    }
  ],
  "parameters": [
    {
      "name": "beta",
      "symbol": "",
      "value": "0.3",
      "description": "transmission rate per day"
    },
    {
      "name": "gamma",
      "symbol": "",
      "value": "1 / 10",
      "description": "recovery rate = 1/(infectious period)"
    }
  ],
  "variables": [
    {
      "name": "lam",
      "symbol": "",
      "expr": "beta * I / N",
      "description": "force of infection",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "c1",
      "to": "c2",
      "kind": "per_capita",
      "rate": "lam",
      "output": "",
      "curve": 40
    },
    {
      "id": "f2",
      "from": "c2",
      "to": "c1",
      "kind": "per_capita",
      "rate": "gamma",
      "output": "",
      "curve": 40
    }
  ]
}
