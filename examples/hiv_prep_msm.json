{
  "version": 1,
  "id": "hiv_prep_msm",
  "category": "Sexually transmitted & blood-borne",
  "name": "HIV among MSM with PrEP and treatment as prevention",
  "description": "HIV in MSM; PrEP.\nParameter values: 0 of 13 checked against the source; the rest are recalled or illustrative.",
  "reference": "Structure is a generic composite in the style of many PrEP models. The efficacy value comes from McCormack S, Dunn DT, et al. Pre-exposure prophylaxis to prevent the acquisition of HIV-1 infection (PROUD). Lancet 2016;387:53–60",
  "referenceUrl": "https://doi.org/10.1016/S0140-6736(15)00056-2",
  "time": {
    "start": "0",
    "stop": "30",
    "step": "0.05",
    "unit": "years"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "S",
      "description": "susceptible not on PrEP",
      "init": "0.88",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 140
    },
    {
      "id": "c2",
      "name": "Sp",
      "description": "susceptible on PrEP",
      "init": "0",
      "inN": true,
      "color": "#FFFFFF",
      "x": 320,
      "y": 140
    },
    {
      "id": "c3",
      "name": "Ia",
      "description": "acute (primary) infection",
      "init": "0.005",
      "inN": true,
      "color": "#B71C1C",
      "x": 520,
      "y": 140
    },
    {
      "id": "c4",
      "name": "Ic",
      "description": "chronic undiagnosed",
      "init": "0.06",
      "inN": true,
      "color": "#B71C1C",
      "x": 720,
      "y": 140
    },
    {
      "id": "c5",
      "name": "Dx",
      "description": "diagnosed, not on ART",
      "init": "0.02",
      "inN": true,
      "color": "#111111",
      "x": 920,
      "y": 140
    },
    {
      "id": "c6",
      "name": "Av",
      "description": "on ART, virally suppressed",
      "init": "0.035",
      "inN": true,
      "color": "#E57373",
      "x": 1120,
      "y": 140
    }
  ],
  "parameters": [
    {
      "name": "cp",
      "symbol": "",
      "value": "5",
      "description": "partner change rate (partners/yr) [illustrative]"
    },
    {
      "name": "beta_c",
      "symbol": "",
      "value": "0.1",
      "description": "transmission probability per partnership from chronic infection (per partnership) [illustrative]"
    },
    {
      "name": "ra",
      "symbol": "",
      "value": "10",
      "description": "relative infectiousness of acute infection [illustrative]"
    },
    {
      "name": "sig_a",
      "symbol": "",
      "value": "4",
      "description": "exit from acute stage (about 3 months) (/yr) [illustrative]"
    },
    {
      "name": "eff_prep",
      "symbol": "",
      "value": "0.86",
      "description": "PrEP efficacy [recalled]"
    },
    {
      "name": "eps_art",
      "symbol": "",
      "value": "0",
      "description": "infectiousness when virally suppressed (U=U) [illustrative]"
    },
    {
      "name": "kappa_p",
      "symbol": "",
      "value": "0.2",
      "description": "PrEP uptake (/yr) [illustrative]"
    },
    {
      "name": "omega_p",
      "symbol": "",
      "value": "0.5",
      "description": "PrEP discontinuation (/yr) [illustrative]"
    },
    {
      "name": "tau_d",
      "symbol": "",
      "value": "0.5",
      "description": "diagnosis rate (/yr) [illustrative]"
    },
    {
      "name": "tau_a",
      "symbol": "",
      "value": "2",
      "description": "ART initiation after diagnosis (/yr) [illustrative]"
    },
    {
      "name": "nu_d",
      "symbol": "",
      "value": "0.1",
      "description": "HIV death if untreated (/yr) [illustrative]"
    },
    {
      "name": "mu",
      "symbol": "",
      "value": "0.03",
      "description": "exit (/yr) [illustrative]"
    },
    {
      "name": "tau_p",
      "symbol": "",
      "value": "4",
      "description": "HIV testing rate while on PrEP (3-monthly); only relevant if a PrEP-specific infection compartment is added (/yr) [illustrative]"
    }
  ],
  "variables": [
    {
      "name": "foi",
      "symbol": "",
      "expr": "cp*beta_c*(ra*Ia + Ic + Dx + eps_art*Av)/N",
      "description": "force of infection",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": null,
      "to": "c1",
      "kind": "absolute",
      "rate": "mu*N + nu_d*(Ic+Dx)",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 10
    },
    {
      "id": "f2",
      "from": "c1",
      "to": "c2",
      "kind": "per_capita",
      "rate": "kappa_p",
      "output": "",
      "curve": 0
    },
    {
      "id": "f3",
      "from": "c2",
      "to": "c1",
      "kind": "per_capita",
      "rate": "omega_p",
      "output": "",
      "curve": 60
    },
    {
      "id": "f4",
      "from": "c1",
      "to": "c3",
      "kind": "per_capita",
      "rate": "foi",
      "output": "",
      "curve": 50
    },
    {
      "id": "f5",
      "from": "c2",
      "to": "c3",
      "kind": "per_capita",
      "rate": "(1-eff_prep)*foi",
      "output": "",
      "curve": 0
    },
    {
      "id": "f6",
      "from": "c3",
