{
  "version": 1,
  "id": "sird",
  "category": "Basic",
  "name": "SIRD",
  "description": "SIR with disease-induced deaths. D is excluded from the living population N.",
  "reference": "Keeling & Rohani (2008), Modeling Infectious Diseases in Humans and Animals, §2.2",
  "referenceUrl": "",
  "time": {
    "start": "0",
    "stop": "200",
    "step": "1",
    "unit": "days"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "S",
      "description": "Susceptible",
      "init": "9990",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 140
    },
    {
      "id": "c2",
      "name": "I",
      "description": "Infectious",
      "init": "10",
      "inN": true,
      "color": "#B71C1C",
      "x": 320,
      "y": 140
    },
    {
      "id": "c3",
      "name": "R",
      "description": "Recovered",
      "init": "0",
      "inN": true,
      "color": "#4E8A3E",
      "x": 520,
      "y": 140
    },
    {
      "id": "c4",
      "name": "D",
      "description": "Dead",
      "init": "0",
      "inN": false,
      "color": "#111111",
      "x": 520,
      "y": 300
    }
  ],
  "parameters": [
    {
      "name": "beta",
      "symbol": "",
      "value": "0.3",
      "description": "transmission rate per day"
    },
    {
      "name": "gamma",
      "symbol": "",
      "value": "1 / 10",
      "description": "rate of leaving the infectious state"
    },
    {
      "name": "cfr",
      "symbol": "",
      "value": "0.02",
      "description": "case fatality ratio"
    }
  ],
  "variables": [
    {
      "name": "lam",
      "symbol": "",
      "expr": "beta * I / N",
      "description": "force of infection",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "c1",
      "to": "c2",
      "kind": "per_capita",
      "rate": "lam",
      "output": "",
      "curve": 0
    },
    {
      "id": "f2",
      "from": "c2",
      "to": "c3",
      "kind": "per_capita",
      "rate": "gamma * (1 - cfr)",
      "output": "",
      "curve": 0
    },
    {
      "id": "f3",
      "from": "c2",
      "to": "c4",
      "kind": "per_capita",
      "rate": "gamma * cfr",
      "output": "deaths",
      "curve": 0
    }
  ]
}
