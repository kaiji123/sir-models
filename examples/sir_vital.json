{
  "version": 1,
  "id": "sir_vital",
  "category": "Basic",
  "name": "SIR with births and deaths",
  "description": "Endemic SIR with demography; damped oscillations to an endemic equilibrium (measles-like parameters).",
  "reference": "Keeling & Rohani (2008), Modeling Infectious Diseases in Humans and Animals, §2.1.2 (Program 2.2)",
  "referenceUrl": "",
  "time": {
    "start": "0",
    "stop": "60",
    "step": "0.02",
    "unit": "years"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "S",
      "description": "Susceptible",
      "init": "10000",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 140
    },
    {
      "id": "c2",
      "name": "I",
      "description": "Infectious",
      "init": "10",
      "inN": true,
      "color": "#B71C1C",
      "x": 320,
      "y": 140
    },
    {
      "id": "c3",
      "name": "R",
      "description": "Recovered",
      "init": "89990",
      "inN": true,
      "color": "#4E8A3E",
      "x": 520,
      "y": 140
    }
  ],
  "parameters": [
    {
      "name": "beta",
      "symbol": "",
      "value": "520",
      "description": "transmission rate per year"
    },
    {
      "name": "gamma",
      "symbol": "",
      "value": "365 / 7",
      "description": "recovery rate per year (7-day infectious period)"
    },
    {
      "name": "mu",
      "symbol": "",
      "value": "1 / 70",
      "description": "birth = death rate per year (70-year life expectancy)"
    }
  ],
  "variables": [
    {
      "name": "lam",
      "symbol": "",
      "expr": "beta * I / N",
      "description": "force of infection",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": null,
      "to": "c1",
      "kind": "absolute",
      "rate": "mu * N",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 10
    },
    {
      "id": "f2",
      "from": "c1",
      "to": "c2",
      "kind": "per_capita",
      "rate": "lam",
      "output": "incidence",
      "curve": 0
    },
    {
      "id": "f3",
      "from": "c2",
      "to": "c3",
      "kind": "per_capita",
      "rate": "gamma",
      "output": "",
      "curve": 0
    },
    {
      "id": "f4",
      "from": "c1",
      "to": null,
      "kind": "per_capita",
      "rate": "mu",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 270
    },
    {
      "id": "f5",
      "from": "c2",
      "to": null,
      "kind": "per_capita",
      "rate": "mu",
      "output": "",
      "curve": 0,
      "ox": 320,
      "oy": 270
    },
    {
      "id": "f6",
      "from": "c3",
      "to": null,
      "kind": "per_capita",
      "rate": "mu",
      "output": "",
      "curve": 0,
      "ox": 520,
      "oy": 270
    }
  ]
}
