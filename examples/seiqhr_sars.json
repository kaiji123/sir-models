{
  "version": 1,
  "id": "seiqhr_sars",
  "category": "Classic extensions",
  "name": "SEIQHR quarantine and isolation (Gumel et al. 2004, SARS)",
  "description": "SARS 2003 (Toronto, Hong Kong, Singapore, Beijing).\nThe headline result is that optimal isolation of symptomatic cases is more effective than sub-optimal isolation combined with quarantine (search summary of the abstract).\nParameter values: 0 of 14 checked against the source; the rest are recalled or illustrative.",
  "reference": "Gumel A.B. et al. (2004) \"Modelling strategies for controlling SARS outbreaks\", Proc. R. Soc. B 271:2223–2232",
  "referenceUrl": "https://doi.org/10.1098/rspb.2004.2800",
  "time": {
    "start": "0",
    "stop": "200",
    "step": "0.2",
    "unit": "days"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "S",
      "description": "susceptible",
      "init": "4000000",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 220
    },
    {
      "id": "c2",
      "name": "E",
      "description": "exposed/asymptomatic, mildly infectious",
      "init": "10",
      "inN": true,
      "color": "#E8C468",
      "x": 320,
      "y": 220
    },
    {
      "id": "c3",
      "name": "Q",
      "description": "quarantined exposed",
      "init": "0",
      "inN": true,
      "color": "#00838F",
      "x": 520,
      "y": 140
    },
    {
      "id": "c4",
      "name": "I",
      "description": "symptomatic infectious",
      "init": "1",
      "inN": true,
      "color": "#B71C1C",
      "x": 520,
      "y": 300
    },
    {
      "id": "c5",
      "name": "H",
      "description": "isolated/hospitalised (Gumel's J)",
      "init": "0",
      "inN": true,
      "color": "#6A2C9C",
      "x": 720,
      "y": 220
    },
    {
      "id": "c6",
      "name": "R",
      "description": "recovered",
      "init": "0",
      "inN": true,
      "color": "#4E8A3E",
      "x": 920,
      "y": 140
    },
    {
      "id": "c7",
      "name": "Dd",
      "description": "cumulative SARS deaths",
      "init": "0",
      "inN": false,
      "color": "#111111",
      "x": 920,
      "y": 300
    }
  ],
  "parameters": [
    {
      "name": "Pi_b",
      "symbol": "",
      "value": "136",
      "description": "recruitment (recalled; or set to muN0) (persons/day)"
    },
    {
      "name": "mu",
      "symbol": "",
      "value": "1/(70*365)",
      "description": "natural death (1/day) [illustrative]"
    },
    {
      "name": "beta",
      "symbol": "",
      "value": "0.2",
      "description": "transmission rate (1/day) [recalled]"
    },
    {
      "name": "eps_E",
      "symbol": "",
      "value": "0.3",
      "description": "relative infectiousness of E [recalled]"
    },
    {
      "name": "eps_Q",
      "symbol": "",
      "value": "0",
      "description": "relative infectiousness of Q [recalled]"
    },
    {
      "name": "eps_H",
      "symbol": "",
      "value": "0.36",
      "description": "relative infectiousness of the isolated (Toronto hospital transmission) [recalled]"
    },
    {
      "name": "gamma1",
      "symbol": "",
      "value": "0.1",
      "description": "quarantine rate of exposed (1/day) [recalled]"
    },
    {
      "name": "gamma2",
      "symbol": "",
      "value": "0.5",
      "description": "isolation rate of symptomatic (1/day) [recalled]"
    },
    {
      "name": "kappa1",
      "symbol": "",
      "value": "0.1",
      "description": "progression E→I (1/day) [recalled]"
    },
    {
      "name": "kappa2",
      "symbol": "",
      "value": "0.125",
      "description": "progression Q→H (1/day) [recalled]"
    },
    {
      "name": "sigma1",
      "symbol": "",
      "value": "0.0337",
      "description": "recovery of I (1/day) [recalled]"
    },
    {
      "name": "sigma2",
      "symbol": "",
      "value": "0.0386",
      "description": "recovery of H (1/day) [recalled]"
    },
    {
      "name": "d1",
      "symbol": "",
      "value": "0.0068",
      "description": "SARS death rate in I (1/day) [recalled]"
    },
    {
      "name": "d2",
      "symbol": "",
      "value": "0.0045",
      "description": "SARS death rate in H (1/day) [recalled]"
    }
  ],
  "variables": [
    {
      "name": "lambda",
      "symbol": "",
      "expr": "beta*(I + eps_E*E + eps_Q*Q + eps_H*H)/N",
      "description": "",
      "output": false
    }
  ],
