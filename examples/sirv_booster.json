{
  "version": 1,
  "id": "sirv_booster",
  "category": "Classic extensions",
  "name": "vaccination with waning and booster doses",
  "description": "pertussis, COVID-19, HPV-like.\nN is constant. Compare b_rate = 0 against b_rate > 0.\nParameter values: 0 of 11 checked against the source; the rest are recalled or illustrative.",
  "reference": "Illustrative structure. The rationale for waning and boosting follows Hethcote 2000 (SIAM Rev",
  "referenceUrl": "https://doi.org/10.1137/S0036144500371907",
  "time": {
    "start": "0",
    "stop": "50",
    "step": "0.05",
    "unit": "years"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "S",
      "description": "never vaccinated, never infected",
      "init": "9000",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 140
    },
    {
      "id": "c2",
      "name": "V1",
      "description": "primary-vaccinated (high protection)",
      "init": "0",
      "inN": true,
      "color": "#2457C5",
      "x": 120,
      "y": 300
    },
    {
      "id": "c3",
      "name": "W",
      "description": "waned (partially susceptible)",
      "init": "0",
      "inN": true,
      "color": "#A5D6A7",
      "x": 720,
      "y": 220
    },
    {
      "id": "c4",
      "name": "V2",
      "description": "boosted",
      "init": "0",
      "inN": true,
      "color": "#2457C5",
      "x": 920,
      "y": 220
    },
    {
      "id": "c5",
      "name": "I",
      "description": "infectious",
      "init": "10",
      "inN": true,
      "color": "#B71C1C",
      "x": 320,
      "y": 220
    },
    {
      "id": "c6",
      "name": "R",
      "description": "recovered",
      "init": "990",
      "inN": true,
      "color": "#4E8A3E",
      "x": 520,
      "y": 220
    }
  ],
  "parameters": [
    {
      "name": "mu",
      "symbol": "",
      "value": "1/70",
      "description": "birth/death (1/yr) [illustrative]"
    },
    {
      "name": "p_nb",
      "symbol": "",
      "value": "0.9",
      "description": "infant primary coverage [illustrative]"
    },
    {
      "name": "omega1",
      "symbol": "",
      "value": "1/4",
      "description": "waning of primary protection (1/yr) [illustrative]"
    },
    {
      "name": "omega2",
      "symbol": "",
      "value": "1/10",
      "description": "waning after booster (1/yr) [illustrative]"
    },
    {
      "name": "omega_r",
      "symbol": "",
      "value": "1/20",
      "description": "waning of infection-derived immunity, flowing into W (1/yr) [illustrative]"
    },
    {
      "name": "b_rate",
      "symbol": "",
      "value": "0.2",
      "description": "booster uptake among waned (1/yr) [illustrative]"
    },
    {
      "name": "eps1",
      "symbol": "",
      "value": "0.1",
      "description": "relative susceptibility in V1 [illustrative]"
    },
    {
      "name": "eps2",
      "symbol": "",
      "value": "0.1",
      "description": "relative susceptibility in V2 [illustrative]"
    },
    {
      "name": "eps_w",
      "symbol": "",
      "value": "0.5",
      "description": "relative susceptibility of the waned [illustrative]"
    },
    {
      "name": "beta",
      "symbol": "",
      "value": "300",
      "description": "transmission (1/yr) [illustrative]"
    },
    {
      "name": "gamma",
      "symbol": "",
      "value": "365/21",
      "description": "recovery (1/yr) [illustrative]"
    }
  ],
  "variables": [
    {
      "name": "lambda",
      "symbol": "",
      "expr": "beta*I/N",
      "description": "",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": null,
      "to": "c1",
      "kind": "absolute",
      "rate": "(1 - p_nb)*mu*N",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 10
    },
    {
      "id": "f2",
      "from": null,
      "to": "c2",
      "kind": "absolute",
      "rate": "p_nb*mu*N",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 170
    },
    {
