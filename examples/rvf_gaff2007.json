  "variables": [
    {
      "name": "Nas",
      "symbol": "",
      "expr": "Sa + Ea + Ia",
      "description": "adult Aedes",
      "output": false
    },
    {
      "name": "Ncs",
      "symbol": "",
      "expr": "Sc + Ec + Ic",
      "description": "adult Culex",
      "output": false
    },
    {
      "name": "Nl",
      "symbol": "",
      "expr": "Sl + El + Il + Rl",
      "description": "livestock",
      "output": false
    },
    {
      "name": "flood",
      "symbol": "",
      "expr": "ifelse(t - 365*floor(t/365) < flood_len, 1, 0)",
      "description": "annual flooding window",
      "output": false
    },
    {
      "name": "lam_l",
      "symbol": "",
      "expr": "(a_a*p_al*Ia + a_c*p_cl*Ic)/Nl",
      "description": "livestock force of infection",
      "output": false
    },
