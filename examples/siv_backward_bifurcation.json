{
  "version": 1,
  "id": "siv_backward_bifurcation",
  "category": "Classic extensions",
  "name": "SIS with vaccination (Kribs-Zaleta & Velasco-Hernández)",
  "description": "generic SIS infection with imperfect waning vaccine.\nThis is the canonical small model where an endemic equilibrium coexists with a stable disease-free state when the vaccine-reduced R_phi < 1.\nParameter values: 0 of 6 checked against the source; the rest are recalled or illustrative.",
  "reference": "Kribs-Zaleta C.M. & Velasco-Hernández J.X. (2000) \"A simple vaccination model with multiple endemic states\", Math. Biosci. 164:183–201",
  "referenceUrl": "https://doi.org/10.1016/S0025-5564(00",
  "time": {
    "start": "0",
    "stop": "50",
    "step": "0.05",
    "unit": "years"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "S",
      "description": "susceptible",
      "init": "9900",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 140
    },
    {
      "id": "c2",
      "name": "I",
      "description": "infectious",
      "init": "100",
      "inN": true,
      "color": "#B71C1C",
      "x": 520,
      "y": 140
    },
    {
      "id": "c3",
      "name": "V",
      "description": "vaccinated",
      "init": "0",
      "inN": true,
      "color": "#2457C5",
      "x": 320,
      "y": 140
    }
  ],
  "parameters": [
    {
      "name": "mu",
      "symbol": "",
      "value": "0.02",
      "description": "birth/death (turnover) (1/yr) [illustrative]"
    },
    {
      "name": "beta",
      "symbol": "",
      "value": "20",
      "description": "transmission (1/yr) [illustrative]"
    },
    {
      "name": "gamma",
      "symbol": "",
      "value": "10",
      "description": "recovery, returning to susceptible (1/yr) [illustrative]"
    },
    {
      "name": "phi_v",
      "symbol": "",
      "value": "1.0",
      "description": "vaccination rate (1/yr) [illustrative]"
    },
    {
      "name": "theta_v",
      "symbol": "",
      "value": "0.1",
      "description": "vaccine waning (1/yr) [illustrative]"
    },
    {
      "name": "sigma_v",
      "symbol": "",
      "value": "0.3",
      "description": "relative susceptibility of the vaccinated [illustrative]"
    }
  ],
  "variables": [
    {
      "name": "lambda",
      "symbol": "",
      "expr": "beta*I/N",
      "description": "",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": null,
      "to": "c1",
      "kind": "absolute",
      "rate": "mu*N",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 10
    },
    {
      "id": "f2",
      "from": "c1",
      "to": "c2",
      "kind": "per_capita",
      "rate": "lambda",
      "output": "",
      "curve": 50
    },
    {
      "id": "f3",
      "from": "c2",
      "to": "c1",
      "kind": "per_capita",
      "rate": "gamma",
      "output": "",
      "curve": 60
    },
    {
      "id": "f4",
      "from": "c1",
      "to": "c3",
      "kind": "per_capita",
      "rate": "phi_v",
      "output": "",
      "curve": 0
    },
    {
      "id": "f5",
      "from": "c3",
      "to": "c1",
      "kind": "per_capita",
      "rate": "theta_v",
      "output": "",
      "curve": 60
    },
    {
      "id": "f6",
      "from": "c3",
      "to": "c2",
      "kind": "per_capita",
      "rate": "sigma_v*lambda",
      "output": "",
      "curve": 0
    },
    {
      "id": "f7",
      "from": "c1",
      "to": null,
      "kind": "per_capita",
      "rate": "mu",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 270
    },
    {
      "id": "f8",
      "from": "c2",
      "to": null,
      "kind": "per_capita",
      "rate": "mu",
      "output": "",
      "curve": 0,
      "ox": 520,
      "oy": 270
    },
    {
      "id": "f9",
      "from": "c3",
      "to": null,
      "kind": "per_capita",
      "rate": "mu",
      "output": "",
      "curve": 0,
      "ox": 320,
      "oy": 270
    }
  ]
}
