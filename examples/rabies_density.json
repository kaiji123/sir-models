{
  "version": 1,
  "id": "rabies_density",
  "category": "Transmission routes",
  "name": "Rabies SEI (density-dependent)",
  "description": "Wildlife rabies with density-dependent transmission (lam = beta * I, not divided by N)\nand logistic population regulation through density-dependent mortality.",
  "reference": "Anderson et al. (1981), Nature 289:765-771",
  "referenceUrl": "",
  "time": {
    "start": "0",
    "stop": "30",
    "step": "0.01",
    "unit": "years"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "S",
      "description": "Susceptible foxes",
      "init": "900",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 140
    },
    {
      "id": "c2",
      "name": "E",
      "description": "Incubating",
      "init": "0",
      "inN": true,
      "color": "#E8C468",
      "x": 320,
      "y": 140
    },
    {
      "id": "c3",
      "name": "I",
      "description": "Rabid",
      "init": "5",
      "inN": true,
      "color": "#B71C1C",
      "x": 520,
      "y": 140
    }
  ],
  "parameters": [
    {
      "name": "b",
      "symbol": "",
      "value": "1",
      "description": "per-capita birth rate per year"
    },
    {
      "name": "mu",
      "symbol": "",
      "value": "0.5",
      "description": "baseline death rate per year"
    },
    {
      "name": "K",
      "symbol": "",
      "value": "1000",
      "description": "carrying capacity"
    },
    {
      "name": "beta",
      "symbol": "",
      "value": "0.08",
      "description": "density-dependent transmission coefficient per year"
    },
    {
      "name": "sigma",
      "symbol": "",
      "value": "13",
      "description": "1/(incubation period) per year (~4 weeks)"
    },
    {
      "name": "alpha",
      "symbol": "",
      "value": "73",
      "description": "rabies death rate per year (~5 days)"
    }
  ],
  "variables": [
    {
      "name": "d",
      "symbol": "",
      "expr": "mu + (b - mu) * N / K",
      "description": "density-dependent death rate",
      "output": false
    },
    {
      "name": "lam",
      "symbol": "",
      "expr": "beta * I",
      "description": "force of infection (density dependent)",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": null,
      "to": "c1",
      "kind": "absolute",
      "rate": "b * N",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 10
    },
    {
      "id": "f2",
      "from": "c1",
      "to": "c2",
      "kind": "per_capita",
      "rate": "lam",
      "output": "",
      "curve": 0
    },
    {
      "id": "f3",
      "from": "c2",
      "to": "c3",
      "kind": "per_capita",
      "rate": "sigma",
      "output": "cases",
      "curve": 0
    },
    {
      "id": "f4",
      "from": "c1",
      "to": null,
      "kind": "per_capita",
      "rate": "d",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 270
    },
    {
      "id": "f5",
      "from": "c2",
      "to": null,
      "kind": "per_capita",
      "rate": "d",
      "output": "",
      "curve": 0,
      "ox": 320,
      "oy": 270
    },
    {
      "id": "f6",
      "from": "c3",
      "to": null,
      "kind": "per_capita",
      "rate": "d",
      "output": "",
      "curve": 0,
      "ox": 490,
      "oy": 270
    },
    {
      "id": "f7",
      "from": "c3",
      "to": null,
      "kind": "per_capita",
      "rate": "alpha",
      "output": "rabies_deaths",
