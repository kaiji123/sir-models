{
  "version": 1,
  "id": "sir",
  "category": "Basic",
  "name": "SIR",
  "description": "Basic SIR epidemic in a closed population.",
  "reference": "Kermack & McKendrick (1927); Keeling & Rohani (2008), Modeling Infectious Diseases in Humans and Animals, §2.1",
  "referenceUrl": "",
  "time": {
    "start": "0",
    "stop": "160",
    "step": "1",
    "unit": "days"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "S",
      "description": "Susceptible",
      "init": "990",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 140
    },
    {
      "id": "c2",
      "name": "I",
      "description": "Infectious",
      "init": "10",
      "inN": true,
      "color": "#B71C1C",
      "x": 320,
      "y": 140
    },
    {
      "id": "c3",
      "name": "R",
      "description": "Recovered",
      "init": "0",
      "inN": true,
      "color": "#4E8A3E",
      "x": 520,
      "y": 140
    }
  ],
  "parameters": [
    {
      "name": "beta",
      "symbol": "",
      "value": "0.3",
      "description": "transmission rate per day"
    },
    {
      "name": "gamma",
      "symbol": "",
      "value": "1 / 10",
      "description": "recovery rate = 1/(infectious period)"
    }
  ],
  "variables": [
    {
      "name": "lam",
      "symbol": "",
      "expr": "beta * I / N",
      "description": "force of infection",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "c1",
      "to": "c2",
      "kind": "per_capita",
      "rate": "lam",
      "output": "incidence",
      "curve": 0
    },
    {
      "id": "f2",
      "from": "c2",
      "to": "c3",
      "kind": "per_capita",
      "rate": "gamma",
      "output": "",
      "curve": 0
    }
  ]
}
