  ],
  "parameters": [
    {
      "name": "b0",
      "symbol": "",
      "value": "60",
      "description": "mean transmission rate (1/year) [illustrative]"
    },
    {
      "name": "b1",
      "symbol": "",
      "value": "0.3",
      "description": "seasonal amplitude [illustrative]"
    },
    {
      "name": "phase",
      "symbol": "",
      "value": "0",
      "description": "seasonal phase (rad) [illustrative]"
    },
    {
      "name": "two_pi",
      "symbol": "",
      "value": "6.283185",
      "description": "constant"
    },
    {
      "name": "sig_lat",
      "symbol": "",
      "value": "91.25",
      "description": "4-day latency (1/year)"
    },
    {
      "name": "nu",
      "symbol": "",
      "value": "36.5",
      "description": "10-day infectious period (1/year)"
    },
    {
      "name": "gam_w",
      "symbol": "",
      "value": "1.825",
      "description": "loss of immunity after about 200 days (1/year)"
    },
    {
      "name": "xi_m",
      "symbol": "",
      "value": "2",
      "description": "loss of maternal protection (about 6 months) (1/year) [illustrative]"
    },
    {
      "name": "f2",
      "symbol": "",
      "value": "0.5",
      "description": "relative susceptibility of S2 [illustrative]"
    },
    {
      "name": "mu",
      "symbol": "",
      "value": "0.0133",
      "description": "birth = death rate, i.e. 1/75 y (1/year) [illustrative]"
    },
    {
      "name": "N0",
      "symbol": "",
      "value": "1e6",
      "description": "value taken from the notes text [recalled]"
    }
  ],
  "variables": [
    {
      "name": "beta1",
      "symbol": "",
      "expr": "b0*(1 + b1*cos(two_pi*t + phase))",
      "description": "",
      "output": false
    },
    {
      "name": "foi1",
      "symbol": "",
      "expr": "beta1*(I1 + I2)/N",
      "description": "",
      "output": false
    }
  ],
