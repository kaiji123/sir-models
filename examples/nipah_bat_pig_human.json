  "variables": [
    {
      "name": "Nb",
      "symbol": "",
      "expr": "Sb + Ib + Rb",
      "description": "bat population",
      "output": false
    },
    {
      "name": "Np",
      "symbol": "",
      "expr": "Sp + Ep + Ip + Rp",
      "description": "pig population",
      "output": false
    },
    {
      "name": "N",
      "symbol": "",
      "expr": "Sh + Eh + Ih + Hh + Rh",
      "description": "living human population",
      "output": false
    },
    {
      "name": "lambda_b",
      "symbol": "",
      "expr": "beta_bb * Ib / Nb",
      "description": "bat force of infection",
      "output": false
    },
    {
      "name": "lambda_p",
      "symbol": "",
      "expr": "beta_pp * Ip / Np + beta_bp * Ib",
      "description": "pig force of infection (within-herd frequency-dependent plus spillover)",
      "output": false
    },
    {
      "name": "lambda_h",
      "symbol": "",
      "expr": "beta_ph * Ip + beta_hh * Ih / N + beta_hosp * Hh / N",
      "description": "human force of infection",
      "output": false
    }
  ],
