{
  "version": 1,
  "id": "hsv2_latent_reactivation",
  "category": "Sexually transmitted & blood-borne",
  "name": "Genital herpes (HSV-2) with primary episode, latency and recurrent reactivation",
  "description": "HSV-2.\nParameter values: 0 of 9 checked against the source; the rest are recalled or illustrative.",
  "reference": "Structure follows Blower SM, Porco TC, Darby G. Predicting and preventing the emergence of antiviral drug resistance in HSV-2. Nat Med 1998;4(6):673–678",
  "referenceUrl": "https://doi.org/10.1038/nm0698-673",
  "time": {
    "start": "0",
    "stop": "50",
    "step": "0.05",
    "unit": "years"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "S",
      "description": "susceptible",
      "init": "0.8",
      "inN": true,
      "color": "#FFFFFF",
      "x": 120,
      "y": 140
    },
    {
      "id": "c2",
      "name": "Ip",
      "description": "primary infection episode (high shedding)",
      "init": "0.01",
      "inN": true,
      "color": "#B71C1C",
      "x": 320,
      "y": 140
    },
    {
      "id": "c3",
      "name": "Lt",
      "description": "latent (low-level asymptomatic shedding)",
      "init": "0.17",
      "inN": true,
      "color": "#E8C468",
      "x": 520,
      "y": 140
    },
    {
      "id": "c4",
      "name": "Rc",
      "description": "recurrent episode (reactivated shedding)",
      "init": "0.02",
      "inN": true,
      "color": "#4E8A3E",
      "x": 720,
      "y": 140
    }
  ],
  "parameters": [
    {
      "name": "cp",
      "symbol": "",
      "value": "2",
      "description": "partner change rate (partners/yr) [illustrative]"
    },
    {
      "name": "beta_p",
      "symbol": "",
      "value": "0.5",
      "description": "transmission from primary episode (per partnership) [illustrative]"
    },
    {
      "name": "beta_r",
      "symbol": "",
      "value": "0.3",
      "description": "transmission from recurrence (per partnership) [illustrative]"
    },
    {
      "name": "beta_l",
      "symbol": "",
      "value": "0.05",
      "description": "transmission from latency (asymptomatic shedding) (per partnership) [illustrative]"
    },
    {
      "name": "d_p",
      "symbol": "",
      "value": "3/52",
      "description": "duration of primary episode (about 3 weeks) (yr) [illustrative]"
    },
    {
      "name": "react",
      "symbol": "",
      "value": "4",
      "description": "reactivation rate (about 4 recurrences/yr in early years) (/yr) [illustrative]"
    },
    {
      "name": "d_r",
      "symbol": "",
      "value": "5/365",
      "description": "duration of a recurrence (yr) [illustrative]"
    },
    {
      "name": "mu",
      "symbol": "",
      "value": "1/30",
      "description": "exit from the sexually active population (/yr) [illustrative]"
    },
    {
      "name": "tx",
      "symbol": "",
      "value": "0",
      "description": "fraction of recurrences shortened by suppressive antivirals [illustrative]"
    }
  ],
  "variables": [
    {
      "name": "foi",
      "symbol": "",
      "expr": "cp*(beta_p*Ip + beta_r*Rc + beta_l*Lt)/N",
      "description": "force of infection",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": null,
      "to": "c1",
      "kind": "absolute",
      "rate": "mu*N",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 10
    },
    {
      "id": "f2",
      "from": "c1",
      "to": "c2",
      "kind": "per_capita",
      "rate": "foi",
      "output": "",
      "curve": 0
    },
    {
      "id": "f3",
      "from": "c2",
      "to": "c3",
      "kind": "per_capita",
      "rate": "1/d_p",
      "output": "",
      "curve": 0
    },
    {
      "id": "f4",
      "from": "c3",
      "to": "c4",
      "kind": "per_capita",
      "rate": "react*(1-tx)",
      "output": "",
      "curve": 0
    },
    {
      "id": "f5",
      "from": "c4",
      "to": "c3",
      "kind": "per_capita",
      "rate": "1/d_r",
      "output": "",
      "curve": 60
    },
    {
      "id": "f6",
      "from": "c1",
      "to": null,
      "kind": "per_capita",
      "rate": "mu",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 270
    },
    {
      "id": "f7",
      "from": "c2",
      "to": null,
      "kind": "per_capita",
      "rate": "mu",
      "output": "",
      "curve": 0,
      "ox": 320,
      "oy": 270
    },
    {
      "id": "f8",
      "from": "c3",
      "to": null,
      "kind": "per_capita",
      "rate": "mu",
      "output": "",
      "curve": 0,
      "ox": 520,
      "oy": 270
    },
    {
      "id": "f9",
      "from": "c4",
      "to": null,
      "kind": "per_capita",
      "rate": "mu",
      "output": "",
      "curve": 0,
      "ox": 720,
      "oy": 270
    }
  ]
}
