{
  "version": 1,
  "id": "ross_macdonald",
  "category": "Transmission routes",
  "name": "Ross–Macdonald (malaria)",
  "description": "SIS humans and SI mosquitoes. Two separate populations, so totals are defined as variables.",
  "reference": "Smith et al. (2012), PLoS Pathogens 8:e1002588; Anderson & May (1991), Infectious Diseases of Humans, ch. 14",
  "referenceUrl": "",
  "time": {
    "start": "0",
    "stop": "730",
    "step": "1",
    "unit": "days"
  },
  "population": {
    "name": "N"
  },
  "compartments": [
    {
      "id": "c1",
      "name": "Sh",
      "description": "Susceptible humans",
      "init": "9990",
      "inN": false,
      "color": "#FFFFFF",
      "x": 120,
      "y": 140
    },
    {
      "id": "c2",
      "name": "Ih",
      "description": "Infected humans",
      "init": "10",
      "inN": false,
      "color": "#B71C1C",
      "x": 320,
      "y": 140
    },
    {
      "id": "c3",
      "name": "Sv",
      "description": "Susceptible mosquitoes",
      "init": "50000",
      "inN": false,
      "color": "#FFFFFF",
      "x": 120,
      "y": 364
    },
    {
      "id": "c4",
      "name": "Iv",
      "description": "Infectious mosquitoes",
      "init": "0",
      "inN": false,
      "color": "#B71C1C",
      "x": 320,
      "y": 364
    }
  ],
  "parameters": [
    {
      "name": "a",
      "symbol": "",
      "value": "0.3",
      "description": "human bites per mosquito per day"
    },
    {
      "name": "b",
      "symbol": "",
      "value": "0.5",
      "description": "probability an infectious bite infects a human"
    },
    {
      "name": "cv",
      "symbol": "c",
      "value": "0.5",
      "description": "probability a mosquito is infected biting an infected human"
    },
    {
      "name": "r",
      "symbol": "",
      "value": "1 / 100",
      "description": "human recovery rate per day"
    },
    {
      "name": "g",
      "symbol": "",
      "value": "1 / 10",
      "description": "mosquito death rate per day"
    }
  ],
  "variables": [
    {
      "name": "Nh",
      "symbol": "",
      "expr": "Sh + Ih",
      "description": "human population",
      "output": false
    },
    {
      "name": "Nv",
      "symbol": "",
      "expr": "Sv + Iv",
      "description": "mosquito population",
      "output": false
    },
    {
      "name": "lam_h",
      "symbol": "λ_h",
      "expr": "a * b * Iv / Nh",
      "description": "force of infection on humans",
      "output": false
    },
    {
      "name": "lam_v",
      "symbol": "λ_v",
      "expr": "a * cv * Ih / Nh",
      "description": "force of infection on mosquitoes",
      "output": false
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "c1",
      "to": "c2",
      "kind": "per_capita",
      "rate": "lam_h",
      "output": "human_incidence",
      "curve": 30
    },
    {
      "id": "f2",
      "from": "c2",
      "to": "c1",
      "kind": "per_capita",
      "rate": "r",
      "output": "",
      "curve": 30
    },
    {
      "id": "f3",
      "from": null,
      "to": "c3",
      "kind": "absolute",
      "rate": "g * Nv",
      "output": "",
      "curve": 0,
      "ox": -30,
      "oy": 364
    },
    {
      "id": "f4",
      "from": "c3",
      "to": "c4",
      "kind": "per_capita",
      "rate": "lam_v",
      "output": "",
      "curve": 0
    },
    {
      "id": "f5",
      "from": "c3",
      "to": null,
      "kind": "per_capita",
      "rate": "g",
      "output": "",
      "curve": 0,
      "ox": 120,
      "oy": 494
    },
    {
      "id": "f6",
      "from": "c4",
      "to": null,
      "kind": "per_capita",
      "rate": "g",
      "output": "",
      "curve": 0,
      "ox": 320,
      "oy": 494
    }
  ]
}
