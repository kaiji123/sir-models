  "variables": [
    {
      "name": "Nr",
      "symbol": "",
      "expr": "Sr + Er + Ir",
      "description": "rodent population",
      "output": false
    },
    {
      "name": "N",
      "symbol": "",
      "expr": "S + V + E + Ii + R",
      "description": "living human population",
      "output": false
    },
    {
      "name": "lambda_r",
      "symbol": "",
      "expr": "beta_rr * Ir / Nr",
      "description": "rodent force of infection",
      "output": false
    },
    {
      "name": "lambda_h",
      "symbol": "",
      "expr": "beta_rh * Ir + beta_hh * Ii / N",
      "description": "human force of infection",
      "output": false
    },
    {
      "name": "R0h",
      "symbol": "",
      "expr": "beta_hh / (gamma_h + mu_h)",
      "description": "human-to-human reproduction number (historically ≈0.3; a 2022-type MSM-outbreak scenario is produced by raising beta_hh so that R0h > 1)",
      "output": false
    }
  ],
